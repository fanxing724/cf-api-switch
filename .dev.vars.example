# 本地开发用的变量模板。复制为 .dev.vars（该文件已被 .gitignore 忽略）后填写。
# 注意：配了 KV 之后，面板的改动会写进 KV，这里的 CHANNELS 不再生效。

# 无 KV 时的兜底渠道配置（JSON 数组）
#   slug      路径标识，决定对外地址 https://<域名>/<slug>/v1/...
#   vendor    generic | deepseek | ark
#   protocol  openai-chat | responses
#   models    白名单，留空表示不限制
CHANNELS=[{"name":"DeepSeek","slug":"deepseek","baseUrl":"https://api.deepseek.com","apiKey":"sk-xxx","vendor":"deepseek","protocol":"openai-chat","models":["deepseek-chat","deepseek-reasoner"],"enabled":true},{"name":"火山方舟","slug":"ark","baseUrl":"https://ark.cn-beijing.volces.com/api/v3","apiKey":"xxx","vendor":"ark","protocol":"openai-chat","models":[],"enabled":true}]

# 站点设置兜底：客户端 Key 与是否强制鉴权（正常走面板设置）
SETTINGS={"requireAuth":false,"clientKeys":[]}

# 上游默认超时（毫秒）
UPSTREAM_TIMEOUT_MS=120000
